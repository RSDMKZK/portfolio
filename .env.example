# Supabase Database Configuration
# Obtain these from your Supabase Dashboard: Project Settings -> API
# Both standard and Next.js public naming conventions are supported:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Alternatively:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Admin Dashboard Passkey (Optional; defaults to 'siba2025' if unset)
ADMIN_SECRET_KEY=siba2025
